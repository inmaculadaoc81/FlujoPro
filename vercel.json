{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/blog.js": { "includeFiles": "index.html" }
  },
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "redirects": [
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:wp(.*-sitemap\\d*\\.xml)",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/((?!(?:flujopro-controls\\.css|hero-degradado\\.css|hero-degradado\\.svg|flujopro-controls|hero-degradado|flujopro\\.css|package\\.json|sitemap\\.xml|vercel\\.json|index\\.html|README\\.txt|robots\\.txt|flujopro|_vercel|package|sitemap|README|robots|vercel|index|blog|api|img)(?:[/.]|$)).+)",
      "destination": "/",
      "permanent": true
    }
  ]
}
