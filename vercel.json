{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:wp(.*-sitemap\\d*\\.xml)",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/((?!(?:flujopro-controls\\.css|hero-degradado\\.css|hero-degradado\\.svg|flujopro-controls|hero-degradado|flujopro\\.css|package\\.json|sitemap\\.xml|vercel\\.json|index\\.html|README\\.txt|robots\\.txt|flujopro|_vercel|package|sitemap|README|robots|vercel|index|api|img)(?:[/.]|$)).+)",
      "destination": "/",
      "permanent": true
    }
  ]
}
